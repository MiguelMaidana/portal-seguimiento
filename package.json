{
  "name": "tablero",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @tablero/web dev",
    "build": "pnpm --filter @tablero/web build",
    "lint": "pnpm --filter @tablero/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @tablero/core test",
    "supabase:start": "pnpm dlx supabase@2.117.0 start",
    "supabase:status": "pnpm dlx supabase@2.117.0 status",
    "supabase:stop": "pnpm dlx supabase@2.117.0 stop"
  }
}
