{
  "name": "tablero",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @tablero/web dev",
    "build": "pnpm --filter @tablero/web build",
